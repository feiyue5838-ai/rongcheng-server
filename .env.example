# ============================================================
# 蓉城企服后端环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================================

# 数据库（PostgreSQL）
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/rongcheng?schema=public"

# 应用端口
PORT=3000

# JWT 密钥（建议使用随机字符串，至少 32 位）
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# 微信小程序配置
WECHAT_APP_ID="your-wechat-app-id"
WECHAT_APP_SECRET="your-wechat-app-secret"

# 微信支付配置（商户号）
WECHAT_MCH_ID="your-merchant-id"
WECHAT_MCH_KEY="your-merchant-key"
WECHAT_SERIAL="your-certificate-serial"
# 商户私钥（需上传证书对应的私钥内容，PKCS8 格式）
WECHAT_PRIVATE_KEY=""
# 微信支付证书路径（用于回调验签）
WECHAT_CERTIFICATE=""

# 微信支付回调地址（需公网可访问）
WECHAT_PAY_NOTIFY_URL="https://your-domain.com/api/wechat/pay-notify"

# 文件上传基础 URL（如果使用 OSS/CDN，请填写真实地址）
UPLOAD_BASE_URL="http://localhost:3000"

# 微信订阅消息模板 ID（门店新订单通知）
# ⚠️ 上线阻断项：留空时 sendNewOrderSubscribeMessage 静默跳过（不报错、不发消息）。
# 申请：mp.weixin.qq.com → 功能 → 订阅消息 → 选用「新订单通知」模板，
# 字段须含 thing(提醒语)/character_string(订单号)/thing(业务类型)/thing(网点名称)，
# 并与小程序前端 utils/config.js 的 WECHAT_SUBSCRIBE_TEMPLATE_ID 保持一致。
WECHAT_SUBSCRIBE_TEMPLATE_ID=""
