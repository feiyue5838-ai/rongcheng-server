model payment_orders {
  id             String    @id @default(uuid())
  payment_no     String    @unique
  order_id       String
  user_id        String
  amount         Decimal   @db.Decimal(10, 2)
  paid_amount    Decimal?  @db.Decimal(10, 2)
  status         Int       @default(1)
  pay_method     String?
  transaction_id String?
  created_at     DateTime  @default(now())
  paid_at        DateTime?
  expired_at     DateTime?
  notify_data    String?

  order              order_orders             @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user               users                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_transactions payment_transactions[]
  refund_orders         refund_orders[]         @relation("RefundPayment")

  @@index([order_id])
  @@index([user_id])
  @@index([status])
  @@map("payment_orders")
}

model payment_transactions {
  id             String   @id @default(uuid())
