  method         String?
  status         Int      @default(1)
  notify_data    String?
  created_at     DateTime @default(now())

  payment payment_orders @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([transaction_no])
  @@map("payment_transactions")
}

model fulfillment_orders {
  id              String    @id @default(uuid())
  fulfillment_no  String    @unique
  order_id        String
  order_no        String
