  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@map("logistics_records")
}

model notifications {
  id String @id @default(uuid()) @map("id")
  userId String? @map("user_id")
  title String @map("title")
  content String @map("content")
  type String @map("type")
  targetType String? @map("target_type")
  targetId String? @map("target_id")
  linkUrl String? @map("link_url")
  isRead Boolean @map("is_read")
  readAt DateTime? @map("read_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@map("notifications")
}

model migrationSealOrdersSnapshot {
  id String @id @map("id")
  data Json @map("data")
  migratedAt DateTime @map("migrated_at")
  migratedTo String? @map("migrated_to")
  migratedBy String? @map("migrated_by")
  @@map("migration_seal_orders_snapshot")
}

model businessConfigs {
  id String @id @default(uuid()) @map("id")
  configKey String @unique @map("config_key")
  configValue String? @map("config_value")
  valueType String @map("value_type")
  description String? @map("description")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@map("business_configs")
}

model dispatchRules {
  id String @id @default(uuid()) @map("id")
  module String @map("module")
  serviceType String? @map("service_type")
  ruleName String @map("rule_name")
  ruleConfig Json @map("rule_config")
  priority Int @map("priority")
  isActive Boolean @map("is_active")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@map("dispatch_rules")
}
model orders {
  id                String    @id @default(uuid())
  order_no          String    @unique
  user_id           String
  module            String
  service_id        String?
  order_status      String    @default("created")
  payment_status    String    @default("unpaid")
  fulfillment_status String   @default("pending_assignment")
  refund_status     String    @default("none")
  invoice_status    String    @default("not_required")
  total_amount      Decimal?  @db.Decimal(18, 2)
  discount_amount   Decimal?  @db.Decimal(18, 2)
  pay_amount        Decimal?  @db.Decimal(18, 2)
  refund_amount     Decimal?  @db.Decimal(18, 2)
  paid_amount       Decimal?  @db.Decimal(18, 2)
  address_snapshot  Json?
  customer_remark   String?
  admin_remark      String?
  reviewed_by       String?
  reviewed_at       DateTime?
  review_result     String?
  paid_at           DateTime?
  completed_at      DateTime?
  cancelled_at      DateTime?
  cancel_reason     String?
  version           Int       @default(1)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())
  deleted_at        DateTime?

  @@index([user_id])
  @@index([order_status])
  @@index([payment_status])
  @@index([fulfillment_status])
  @@index([created_at])
  @@map("orders")
  fulfillment_orders fulfillment_orders[]
}


