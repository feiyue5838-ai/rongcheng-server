generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id         String   @id @default(uuid())
  user_id    String
  contact    String
  phone      String
  province   String
  city       String
  district   String
  detail     String
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model admins {
  id            String    @id @default(uuid())
  username      String    @unique
  password      String
  nickname      String?
  role          String    @default("operator")
  permissions   String[]
  status        Int       @default(1)
  last_login_at DateTime?
  last_login_ip String?
  created_at    DateTime  @default(now())
  updated_at    DateTime @updatedAt
}

model bookkeeping_packages {
  id            String   @id @default(uuid())
  name          String
  taxpayer_type String
  cycle         String
  base_price    Decimal  @db.Decimal(10, 2)
  invoice_price       Decimal  @default(0) @db.Decimal(10, 2)
  invoice_price_normal Decimal @default(0) @db.Decimal(10, 2)
  social_price        Decimal  @default(0) @db.Decimal(10, 2)
  fund_price    Decimal  @default(0) @db.Decimal(10, 2)
  description   String?
  features      String?
  sort          Int      @default(0)
  status        Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([taxpayer_type, cycle])
}

model delivery_receipts {
  id          String      @id @default(uuid())
  order_id    String
  outlet_id   String
  type        String
  url         String
  remark      String?
  created_at  DateTime    @default(now())
  seal_orders seal_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  outlet     outlets     @relation(fields: [outlet_id], references: [id])
}

model invoices {
  id           String   @id @default(uuid())
  user_id      String
  type         Int      @default(1)
  title        String
  tax_no       String?
  bank         String?
  bank_account String?
  address      String?
  phone        String?
  email        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model materials {
  id          String      @id @default(uuid())
  order_id    String
  type        String
  url         String
  status      Int         @default(0)
  remark      String?
  created_at  DateTime    @default(now())
  updated_at  DateTime @updatedAt
  seal_orders seal_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model newspaper_categories {
  id                  String                @id @default(uuid())
  name                String
  icon                String?
  sort                Int                   @default(0)
  status              Int                   @default(1)
  created_at          DateTime              @default(now())
  updated_at          DateTime @updatedAt
  sub_types           Json?
  newspaper_templates newspaper_templates[]
  newspapers          newspapers[]
}

model newspaper_templates {
  id                   String               @id @default(uuid())
  newspaper_id         String?
  category_id          String?
  name                 String
  content              String
  sample_data          String?
  sort                 Int                  @default(0)
  status               Int                  @default(1)
  created_at           DateTime             @default(now())
  updated_at           DateTime @updatedAt
  businessType         String?   // @deprecated 废弃：仅作展示备注，已由 templateType 替代
  color                String?
  desc                 String?
  templateType         String?   // 子分类 key（英文，唯一标识）
  newspaper_categories newspaper_categories? @relation(fields: [category_id], references: [id])
  newspaper            newspapers?           @relation(fields: [newspaper_id], references: [id])
}

model newspapers {
  id                   String                @id @default(uuid())
  name                 String
  alias                String?
  publisher            String?
  province             String?
  city                 String?
  price_per_word       Decimal               @db.Decimal(10, 2)
  min_words            Int                   @default(50)
  coverage             Int                   @default(1)
  level                Int                   @default(1)
  image                String?
  description          String?
  status               Int                   @default(1)
  sort                 Int                   @default(0)
  created_at           DateTime              @default(now())
  updated_at           DateTime @updatedAt
  category_id          String?
  city_code            String?
  province_code        String?
  region               String?
  enable_sections      Int                   @default(1) // 小程序下单是否启用版面选择
  newspaper_templates  newspaper_templates[]
  newspaper_sections   newspaper_sections[]
  newspaper_categories newspaper_categories? @relation(fields: [category_id], references: [id])
}

model newspaper_sections {
  id              String     @id @default(uuid())
  newspaper_id    String
  name            String
  category        String?    // 版面类别：头版/二版/财经版/分类广告版等
  list_price      Decimal    @default(0) @db.Decimal(10, 2) // 刊例价
  deadline_time   String?    // 截稿时间，如 "17:00"
  publish_cycle   String?    // 见报周期，如 "每周一/三/五" 或 "次日见报"
  sort            Int        @default(0)
  status          Int        @default(1)
  remark          String?    // 备注
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  newspaper       newspapers @relation(fields: [newspaper_id], references: [id], onDelete: Cascade)

  @@index([newspaper_id, status])
  @@index([newspaper_id, sort])
}

model operation_logs {
  id         String   @id @default(uuid())
  admin_id   String?
  module     String?
  action     String?
  target     String?
  detail     String?
  ip         String?
  user_agent String?
  created_at DateTime @default(now())
}

model order_assignments {
  id           String      @id @default(uuid())
  order_id     String      @unique
  outlet_id    String
  status       Int         @default(1)
  status_text  String      @default("待接单")
  assigned_by  String?
  assigned_at  DateTime    @default(now())
  accepted_at  DateTime?
  completed_at DateTime?
  remark       String?
  seal_orders  seal_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  outlet      outlets     @relation(fields: [outlet_id], references: [id])
}

model order_items {
  id            String         @id @default(uuid())
  order_id      String
  item_type     String
  seal_id       String?
  package_id    String?
  name          String
  price         Decimal        @db.Decimal(10, 2)
  quantity      Int            @default(1)
  image         String?
  created_at    DateTime       @default(now())
  seal_orders   seal_orders    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  // 注意：seal_id / package_id 仅作业务标识（前端硬编码 s1-s47 / p1-p7 等），
  // 不关联 seals / seal_packages 表（后者 id 为 uuid，与前端业务 id 不匹配）。
  // 故去掉外键约束，避免下单时外键校验失败导致 500。
}

model outlet_notifications {
  id         String   @id @default(uuid())
  outlet_id  String
  title      String
  content    String
  type       String   @default("order")
  order_id   String?
  order_no   String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  outlet    outlets  @relation(fields: [outlet_id], references: [id])

  @@index([outlet_id, created_at])
  @@index([outlet_id, is_read])
}

model business_types {
  id    String @id @default(uuid())
  name  String @unique  // 刻章/登报/代理记账
  code  String @unique  // seal/newspaper/accounting
  outlets outlet_business_types[]
}

model outlet_business_types {
  id              String @id @default(uuid())
  outlet_id       String
  business_type_id String
  outlet          outlets        @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
  business_type   business_types @relation(fields: [business_type_id], references: [id])

  @@unique([outlet_id, business_type_id])
  @@index([business_type_id])
}

model outlets {
  id                   String                 @id @default(uuid())
  name                 String
  contact              String
  phone                String                 @unique
  password             String
  province             String?
  city                 String?
  district             String?
  address              String?
  status               Int                    @default(1)
  priority             Int                    @default(0)
  total_orders         Int                    @default(0)
  last_login_at        DateTime?
  last_login_ip        String?
  created_at           DateTime               @default(now())
  updated_at           DateTime @updatedAt
  service_area         String                 @default("[]")
  business_license     String?
  special_permits      String                 @default("[]")
  outlet_openid        String?
  subscribe_msg        Int                    @default(1)
  delivery_receipts    delivery_receipts[]
  assignments    order_assignments[]
  outlet_notifications outlet_notifications[]
  outlet_business_types outlet_business_types[]
  priority_info outlet_priority?
  settlement_records settlement_records[]
  settlement_cycle           String?  // 自动结算周期: 'daily' | 'weekly' | 'monthly'，null=不自动结算（手动）
  settlement_weekly_start_day Int?     @default(1) // 周几起算 0-6（0=周日，1=周一），仅 weekly 生效
}

model personal_doc_categories {
  id                 String               @id @default(uuid())
  name               String
  desc               String?
  color              String?
  icon               String?
  sort               Int                  @default(0)
  status             Int                  @default(1)
  created_at         DateTime             @default(now())
  updated_at         DateTime @updatedAt
  personal_doc_items personal_doc_items[]
}

model personal_doc_items {
  id                      String                  @id @default(uuid())
  category_id             String
  name                    String
  content                 String?
  desc                    String?
  sort                    Int                     @default(0)
  status                  Int                     @default(1)
  created_at              DateTime                @default(now())
  updated_at              DateTime @updatedAt
  personal_doc_categories personal_doc_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
}

model question_replies {
  id          String    @id @default(uuid())
  question_id String
  author_type String
  author_id   String
  author_name String
  content     String
  created_at  DateTime  @default(now())
  replies   questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([question_id])
}

model questions {
  id               String             @id @default(uuid())
  user_id          String?
  user_name        String             @default("热心用户")
  content          String
  images           String[]
  module           String             @default("seal_biz")
  status           String             @default("pending")
  reply_count      Int                @default(0)
  created_at       DateTime           @default(now())
  updated_at       DateTime @updatedAt
  question_replies question_replies[]
  user            users?             @relation(fields: [user_id], references: [id])

  @@index([module, status])
  @@index([status, created_at])
}

model reviews {
  id          String      @id @default(uuid())
  order_id    String
  user_id     String
  module      String      @default("seal")
  rating      Int
  content     String
  images      String[]
  reply       String?
  reply_at    DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime @updatedAt
  status      String      @default("pending")
  seal_orders seal_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user       users       @relation(fields: [user_id], references: [id])
}

model seal_categories {
  id         String   @id @default(uuid())
  name       String
  icon       String?
  sort       Int      @default(0)
  status     Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  seals      seals[]
}

model seal_orders {
  id                    String              @id @default(uuid())
  order_no              String              @unique
  user_id               String
  module                String              @default("seal")
  type                  String              @default("在线刻章")
  company_name          String?
  legal_person          String?
  license_region        String?
  seal_reason           String?
  contact_phone         String?
  legal_phone           String?
  total_price           Decimal             @db.Decimal(10, 2)
  pay_price             Decimal?            @db.Decimal(10, 2)
  address_id            String?
  address_json          String?
  license_address_json  String? // 执照地区JSON,用于派单匹配 {province,city,district}
  need_invoice          Boolean             @default(false)
  invoice_id            String?
  status                Int                 @default(1)
  status_text           String              @default("待支付")
  remark                String?
  pay_time              DateTime?
  pay_method            String?
  transaction_id        String?
  express_company       String?
  express_no            String?
  admin_remark          String?
  processed_by          String?
  processed_at          DateTime?
  created_at            DateTime            @default(now())
  updated_at            DateTime @updatedAt
  assignment_status     Int                 @default(0)
  delivered_at          DateTime?
  delivery_status       Int                 @default(0)
  signed_at             DateTime?
  newspaper_content     String?
  newspaper_issue_count Int?
  invoice_json          String?
  newspaper_copy_count  Int?
  newspaper_id          String?
  newspaper_section_id  String?
  newspaper_section_name String?
  newspaper_images      String?
  delivery_receipts     delivery_receipts[]
  materials             materials[]
  assignment     order_assignments?
  order_items           order_items[]
  reviews               reviews[]
  user                 users               @relation(fields: [user_id], references: [id])
}

model seal_packages {
  id                  String                @id @default(uuid())
  name                String
  description         String?
  badge               String?
  price               Decimal               @db.Decimal(10, 2)
  seal_ids            String[]
  status              Int                   @default(1)
  sort                Int                   @default(0)
  created_at          DateTime              @default(now())
  updated_at          DateTime @updatedAt
  images              String[]
  region_prices       Json?
  seal_scene_packages seal_scene_packages[]
}

model seal_scene_packages {
  scene_id      String
  package_id    String
  sort          Int           @default(0)
  created_at    DateTime      @default(now())
  package seal_packages @relation(fields: [package_id], references: [id])
  seal_scenes   seal_scenes   @relation(fields: [scene_id], references: [id])

  @@id([scene_id, package_id])
}

model seal_scene_seals {
  scene_id    String
  seal_id     String
  sort        Int         @default(0)
  created_at  DateTime    @default(now())
  seal_scenes seal_scenes @relation(fields: [scene_id], references: [id])
  seal       seals       @relation(fields: [seal_id], references: [id])

  @@id([scene_id, seal_id])
}

model seal_scenes {
  id                  String                @id @default(uuid())
  name                String
  description         String?
  icon                String?
  bgColor             String?
  route               String?
  sort                Int                   @default(0)
  status              Int                   @default(1)
  sceneType           String                @default("scene")
  created_at          DateTime              @default(now())
  updated_at          DateTime @updatedAt
  seal_scene_packages seal_scene_packages[]
  seal_scene_seals    seal_scene_seals[]
}

model seals {
  id               String             @id @default(uuid())
  category_id      String?
  name             String
  description      String?
  image            String?
  price            Decimal            @db.Decimal(10, 2)
  region_prices   Json              @default("{}") @db.Json
  status           Int                @default(1)
  sort             Int                @default(0)
  created_at       DateTime           @default(now())
  updated_at       DateTime @updatedAt
  seal_scene_seals seal_scene_seals[]
  seal_categories  seal_categories?   @relation(fields: [category_id], references: [id])
}

model system_configs {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  value_type  String   @default("string")
  group       String   @default("default")
  name        String?
  description String?
  sort        Int      @default(0)
  status      Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model content_banners {
  id         String   @id @default(uuid())
  title      String
  image      String
  link       String?
  sort       Int      @default(0)
  status     Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model content_announcements {
  id           String    @id @default(uuid())
  title        String
  content      String
  status       Int       @default(1)
  published_at DateTime?
  expired_at   DateTime?
  operator     String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}

model content_intros {
  id         String   @id @default(uuid())
  title      String
  subtitle   String?
  image      String
  sort       Int      @default(0)
  status     Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model users {
  id            String        @id @default(uuid())
  openid        String?       @unique
  unionid       String?       @unique
  nickname      String?
  avatar        String?
  phone         String?       @unique
  realname      String?
  id_card       String?
  status        Int           @default(1)
  last_login_at DateTime?
  last_login_ip String?
  created_at    DateTime      @default(now())
  updated_at    DateTime @updatedAt
  addresses     addresses[]
  invoices      invoices[]
  questions     questions[]
  reviews       reviews[]
  seal_orders   seal_orders[]
}

// 派单全局配置
model dispatch_config {
  id                String    @id @default(uuid())
  mode              String    @default("auto")  // auto=自动派单, manual=纯手动, hybrid=自动+可改
  auto_assign       Boolean   @default(true)
  business_type_filter Boolean @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  updated_by        String?
}

// 网点优先级
model outlet_priority {
  id         String   @id @default(uuid())
  outlet_id  String   @unique
  priority   Int      @default(0)
  remark     String?
  updated_at DateTime @updatedAt
  outlet     outlets  @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
}

// 强制手动派单地区
model forced_manual_regions {
  id         String   @id @default(uuid())
  province   String
  city       String?
  remark     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  updated_by String?
}

// ========== 结算系统 ==========

// 结算规则配置
model settlement_rules {
  id              String    @id @default(uuid())
  name            String    // 规则名称，如"默认规则"
  type            String    @default("fixed") // fixed=固定金额, percent=固定比例
  fixed_amount    Decimal   @default(50)       @db.Decimal(10, 2) // 固定金额（当type=fixed）
  percent         Decimal   @default(0)        @db.Decimal(5, 2)  // 固定比例%（当type=percent）
  min_order_amount Decimal  @default(0)        @db.Decimal(10, 2) // 单笔订单最低金额要求
  settlement_type String    @default("manual") // manual=手动结算, auto=自动结算
  status          Int       @default(1)        // 1=启用, 0=禁用
  is_default      Boolean   @default(false)    // 是否为默认规则
  remark          String?   // 备注
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  created_by      String?
  outlet_id       String?
  module          String?   // 模块：seal/newspaper/bookkeeping，空=全部
  valid_from      DateTime? // 规则生效日期
  valid_to        DateTime? // 规则失效日期
}

// 结算记录
model settlement_records {
  id              String    @id @default(uuid())
  record_no       String    @unique // 结算单号，如 ST20260805001
  outlet_id       String
  outlet_name     String    // 冗余存储，方便查询
  period_start    DateTime  // 结算周期开始
  period_end      DateTime  // 结算周期结束
  order_count     Int       @default(0) // 订单数量
  order_amount    Decimal   @default(0) @db.Decimal(12, 2) // 订单总金额
  outlet_amount   Decimal   @default(0) @db.Decimal(12, 2) // 网点所得
  platform_amount Decimal   @default(0) @db.Decimal(12, 2) // 平台所得
  rule_id         String?   // 使用的结算规则ID
  rule_name       String?   // 使用的结算规则名称（冗余）
  module_detail   String?   // 各模块结算明细 JSON
  status          Int       @default(1) // 1=待确认, 2=已结算, 3=已付款
  status_text     String    @default("待确认")
  paid_at         DateTime? // 付款时间
  paid_by         String?   // 付款人
  paid_remark     String?   // 付款备注
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  created_by      String?   // 操作人
  outlet          outlets   @relation(fields: [outlet_id], references: [id])

  @@index([outlet_id])
  @@index([status])
  @@index([period_start, period_end])
  @@index([created_at])
}

// ========== 交易流水系统 ==========

// 交易流水（统一记录所有资金往来）
model transaction_flows {
  id              String    @id @default(uuid())
  transaction_no  String    @unique // 交易单号，如 TF20260805001
  order_id        String?   // 关联订单ID
  order_no        String?   // 关联订单号（冗余）
  module          String    // seal/newspaper/bookkeeping/refund/recharge
  business_type   String    // 业务类型中文：刻章/登报/代理记账/退款/充值
  trade_type      String    // income=收入/refund=退款/withdraw=提现/recharge=充值
  user_id         String?   // 支付用户ID
  user_name       String?   // 用户昵称（冗余）
  user_phone      String?   // 用户手机号（冗余）
  amount          Decimal   @default(0) @db.Decimal(12, 2)   // 交易金额
  fee             Decimal   @default(0) @db.Decimal(12, 2)   // 手续费
  net_amount      Decimal   @default(0) @db.Decimal(12, 2)   // 实收金额
  pay_method      String?   // 支付方式：wechat/alipay/balance
  status          String    @default("success") // success/failed/pending/refunded
  status_text     String    @default("交易成功")
  transaction_id  String?   // 第三方交易流水号（微信/支付宝）
  outlet_id       String?   // 服务商（网点）ID，订单归属网点
  outlet_name     String?   // 服务商（网点）名称（冗余）
  remark          String?   // 备注
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([created_at])
  @@index([module])
  @@index([trade_type])
  @@index([status])
  @@index([user_id])
  @@index([order_id])
  @@index([outlet_id])
  @@index([transaction_no])
}


model refund_records {
  id           String   @id @default(uuid())
  order_id     String
  order_no     String
  user_id      String?
  amount       Decimal  @db.Decimal(12, 2)
  reason       String?
  status       Int      @default(1) // 1申请 2通过 3已退款 4拒绝
  status_text  String   @default("申请中")
  apply_by     String?
  reviewed_by  String?
  reviewed_at  DateTime?
  review_note  String?
  refunded_at  DateTime?
  refund_id    String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

// ========== 菜单权限配置 ==========
model menu_role_config {
  id        String   @id @default(uuid())
  path      String
  path_type String   // route | page
  roles     String[] // JSON text[]，如 ["admin","outlet"]
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  updated_by String?

  @@index([path])
}

// ========== 服务商合作价格配置 ==========
model outlet_pricing {
  id            String    @id @default(uuid())
  outlet_id     String    // 服务商（网点）ID
  business_type String    // 业务类型：seal / newspaper / bookkeeping
  unit          String    // 单位：个/枚（刻章）/ 期（登报）/ 家（代理记账）
  price_type    String    // 计费方式：fixed 固定金额 / percent 百分比
  price_value   Decimal   @db.Decimal(12, 2) // 金额或百分比值
  status        Int       @default(1) // 1=启用 0=停用
  remark        String?   // 备注
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@unique([outlet_id, business_type])
  @@index([outlet_id])
}

model faq_categories {
  id         Int      @id @default(autoincrement())
  name       String
  icon       String?
  sort       Int      @default(0)
  status     Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model faqs {
  id          Int      @id @default(autoincrement())
  category_id Int
  question    String
  answer      String
  sort        Int      @default(0)
  status      Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
}
