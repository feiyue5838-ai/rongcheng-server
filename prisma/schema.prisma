  order       order_orders       @relation(fields: [order_id], references: [id])
  fulfillment fulfillment_orders @relation(fields: [fulfillment_id], references: [id])

  @@index([settlement_id])
  @@index([order_id])
  @@map("settlement_items")
}

model refund_orders {
  id          String    @id @default(uuid())
  refund_no   String    @unique
  order_id    String
  payment_id  String?
  amount      Decimal   @db.Decimal(10, 2)
  reason      String?
  status      Int       @default(1)
