// ==================== DDD 架构新模型 ====================
// 注意：这些模型对应新建的表，与旧模型并存

model order_orders {
  id              String    @id @default(uuid())
  order_no        String    @unique
  user_id         String
  biz_type        String    // 'seal'|'newspaper'|'bookkeeping'
  biz_subtype     String?
  total_amount    Decimal   @db.Decimal(10, 2)
  pay_amount      Decimal?  @db.Decimal(10, 2)
  discount_amount Decimal   @default(0) @db.Decimal(10, 2)
  status          Int       @default(1)
  status_text     String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  paid_at         DateTime?
  fulfilled_at    DateTime?
  completed_at    DateTime?
  canceled_at     DateTime?
  remark          String?
  admin_remark    String?

  user                       users                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order_items_new            order_items_new[]
  order_seal_details         order_seal_details?
  order_newspaper_details    order_newspaper_details?
  order_bookkeeping_details  order_bookkeeping_details?
  payment_orders             payment_orders[]
  settlement_items           settlement_items[]
  refund_orders              refund_orders[]

  @@index([user_id])
  @@index([biz_type])
  @@index([status])
  @@index([created_at])
  @@map("order_orders")
}

model order_items_new {
  id         String   @id @default(uuid())
  order_id   String
  item_type  String
  item_id    String?
  name       String
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(1)
  image      String?
  specs      String?
  created_at DateTime @default(now())

  order     order_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_items_new")
}

model order_seal_details {
  order_id       String   @id
