// Prisma Schema - 蓉城企服后端数据库
// 数据库：PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 公共模块
// ============================================================

/// 用户表
model User {
  id            String    @id @default(uuid())
  openid        String?   @unique @map("openid")           // 微信 openid
  unionid       String?   @unique @map("unionid")          // 微信 unionid
  nickname      String?   @map("nickname")                  // 昵称
  avatar        String?   @map("avatar")                    // 头像 URL
  phone         String?   @unique @map("phone")             // 手机号
  realname      String?   @map("realname")                  // 真实姓名
  idCard        String?   @map("id_card")                  // 身份证号（加密存储）
  status        Int       @default(1) @map("status")        // 状态：0=禁用 1=正常
  lastLoginAt   DateTime? @map("last_login_at")             // 最后登录时间
  lastLoginIp   String?   @map("last_login_ip")             // 最后登录 IP
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // 关系
  addresses     Address[]                                      // 收货地址
  orders        SealOrder[]                                    // 订单
  reviews       Review[]                                       // 评价
  invoices      Invoice[]                                      // 发票

  @@map("users")
}

/// 收货地址表
model Address {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  contact    String                                  // 联系人
  phone      String                                  // 手机号
  province   String                                  // 省份
  city       String                                  // 城市
  district   String                                  // 区县
  detail     String                                  // 详细地址
  isDefault  Boolean  @default(false) @map("is_default") // 是否默认
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

/// 发票表
model Invoice {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        Int      @default(1)                        // 类型：1=个人 2=企业
  title       String                                  // 发票抬头
  taxNo       String?  @map("tax_no")                    // 税号（企业）
  bank        String?  @map("bank")                      // 开户银行
  bankAccount String?  @map("bank_account")              // 银行账号
  address     String?  @map("address")                   // 注册地址
  phone       String?  @map("phone")                     // 注册电话
  email       String?  @map("email")                    // 接收邮箱
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

// ============================================================
// 刻章模块
// ============================================================

/// 印章业务场景表（首页 4 大类 + 自选 8 场景）
model SealScene {
  id          String   @id @default(uuid())
  name        String                                  // 场景名称
  description String?                                 // 描述
  icon        String?                                 // 图标 key
  bgColor     String?                                 // 背景色
  route       String?                                 // 跳转路由
  sort        Int      @default(0)                    // 排序
  status      Int      @default(1)                    // 状态：0=禁用 1=启用
  sceneType   String   @default("scene")             // scene=自选场景 home=首页入口
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sealSceneSeals    SealSceneSeal[]
  sealScenePackages SealScenePackage[]

  @@map("seal_scenes")
}

/// 印章场景-产品关联表
model SealSceneSeal {
  sceneId     String   @map("scene_id")
  sealId      String   @map("seal_id")
  sort        Int      @default(0)                    // 在该场景内的排序
  createdAt   DateTime @default(now()) @map("created_at")

  scene       SealScene @relation(fields: [sceneId], references: [id])
  seal        Seal      @relation(fields: [sealId], references: [id])

  @@id([sceneId, sealId])
  @@map("seal_scene_seals")
}

/// 印章场景-套餐关联表
model SealScenePackage {
  sceneId     String   @map("scene_id")
  packageId   String   @map("package_id")
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  scene       SealScene @relation(fields: [sceneId], references: [id])
  package     SealPackage @relation(fields: [packageId], references: [id])

  @@id([sceneId, packageId])
  @@map("seal_scene_packages")
}

/// 印章分类表
model SealCategory {
  id          String   @id @default(uuid())
  name        String                                  // 分类名称
  icon        String?                                 // 图标
  sort        Int      @default(0)                    // 排序
  status      Int      @default(1)                    // 状态：0=禁用 1=启用
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  seals       Seal[]

  @@map("seal_categories")
}

/// 印章产品表
model Seal {
  id          String   @id @default(uuid())
  categoryId  String?  @map("category_id")             // 分类 ID（已弃用，使用 sceneSeals）
  name        String                                  // 印章名称
  description String?  @map("description")              // 描述
  image       String?                                 // 图片 URL
  price       Decimal  @db.Decimal(10, 2)              // 单价（元）
  status      Int      @default(1)                    // 状态：0=下架 1=上架
  sort        Int      @default(0)                    // 排序
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category    SealCategory? @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  sceneSeals  SealSceneSeal[]

  @@map("seals")
}

/// 印章套餐表
model SealPackage {
  id          String   @id @default(uuid())
  name        String                                  // 套餐名称
  description String?  @map("description")              // 描述
  badge       String?                                 // 标签（如"特惠"）
  price       Decimal  @db.Decimal(10, 2)              // 套餐价格
  sealIds     String[]  @map("seal_ids")               // 包含的印章 ID 列表
  status      Int      @default(1)                    // 状态：0=下架 1=上架
  sort        Int      @default(0)                    // 排序
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItems  OrderItem[]
  scenePackages  SealScenePackage[]

  @@map("seal_packages")
}

/// 刻章订单表
model SealOrder {
  id              String   @id @default(uuid())
  orderNo         String   @unique @map("order_no")    // 订单编号
  userId          String   @map("user_id")             // 用户 ID
  module          String   @default("seal") @map("module") // 模块：seal/newspaper
  type            String   @default("在线刻章") @map("type") // 订单类型
  // 刻章相关字段
  companyName     String?  @map("company_name")         // 公司名称
  legalPerson     String?  @map("legal_person")        // 法人姓名
  licenseRegion    String?  @map("license_region")      // 执照地区
  sealReason      String?  @map("seal_reason")         // 刻章原因
  contactPhone    String?  @map("contact_phone")        // 联系电话
  legalPhone      String?  @map("legal_phone")         // 法人电话
  // 金额
  totalPrice      Decimal  @db.Decimal(10, 2) @map("total_price") // 订单总价
  payPrice        Decimal? @db.Decimal(10, 2) @map("pay_price")   // 实付金额
  // 地址
  addressId       String?  @map("address_id")           // 收货地址 ID
  addressJson     String?  @map("address_json")         // 收货地址快照（JSON）
  // 发票
  needInvoice     Boolean  @default(false) @map("need_invoice")
  invoiceId       String?  @map("invoice_id")           // 发票 ID
  // 状态
  status          Int      @default(1)                  // 订单状态：1=待支付 2=已支付 3=制作中 4=已发货 5=已完成 6=已取消 7=退款中 8=已退款
  statusText      String   @default("待支付") @map("status_text")
  remark          String?                                 // 用户备注
  // 支付信息
  payTime         DateTime? @map("pay_time")            // 支付时间
  payMethod       String?  @map("pay_method")           // 支付方式
  transactionId   String?  @map("transaction_id")       // 微信支付单号
  // 物流
  expressCompany  String?  @map("express_company")     // 快递公司
  expressNo       String?  @map("express_no")          // 快递单号
  // 管理
  adminRemark     String?  @map("admin_remark")        // 管理员备注
  processedBy     String?  @map("processed_by")         // 处理人
  processedAt     DateTime? @map("processed_at")       // 处理时间
  // 分配与交付
  assignmentStatus Int     @default(0) @map("assignment_status")  // 分配状态：0=未分配 1=已分配 2=制作中 3=已完成
  deliveryStatus  Int     @default(0) @map("delivery_status")     // 交付状态：0=待交付 1=已交付 2=已签收
  deliveredAt    DateTime? @map("delivered_at")      // 交付时间
  signedAt       DateTime? @map("signed_at")         // 客户签收时间
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]
  materials       Material[]
  reviews         Review[]
  assignment      OrderAssignment?                     // 订单分配（一对一）
  receipts        DeliveryReceipt[]                    // 交付回执

  @@map("seal_orders")
}

/// 订单明细表（印章+登报通用）
model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  itemType    String   @map("item_type")               // 类型：seal/package/newspaper/template
  sealId      String?  @map("seal_id")                 // 印章 ID
  packageId   String?  @map("package_id")             // 套餐 ID
  name        String                                  // 商品名称（快照）
  price       Decimal  @db.Decimal(10, 2)              // 单价（快照）
  quantity    Int      @default(1)                    // 数量
  image       String?                                 // 图片（快照）
  createdAt   DateTime @default(now()) @map("created_at")

  order       SealOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seal        Seal?      @relation(fields: [sealId], references: [id])
  package     SealPackage? @relation(fields: [packageId], references: [id])

  @@map("order_items")
}

/// 材料表
model Material {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  type        String                                  // 材料类型：license/id_card_front/id_card_back/photo/professional_cert/signature/handheld_id/additional
  url         String                                  // 文件 URL
  status      Int      @default(0)                    // 审核状态：0=待审核 1=通过 2=驳回
  remark      String?                                 // 审核备注
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order       SealOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("materials")
}

// ============================================================
// 登报模块
// ============================================================

/// 报纸表
model Newspaper {
  id          String   @id @default(uuid())
  name        String                                  // 报纸名称
  alias       String?  @map("alias")                   // 别名
  publisher   String?  @map("publisher")               // 出版社
  province    String?                                 // 省份
  city        String?                                 // 城市
  pricePerWord Decimal @db.Decimal(10, 2) @map("price_per_word") // 每字价格（元）
  minWords    Int      @default(50) @map("min_words")  // 最少字数
  coverage    Int      @default(1)                     // 发行覆盖：1=市级 2=省级 3=全国
  level       Int      @default(1)                     // 级别：1=普通 2=省级 3=国家级
  image       String?                                 // 报纸封面图
  description String?  @map("description")              // 描述
  status      Int      @default(1)                    // 状态：0=停用 1=启用
  sort        Int      @default(0)                    // 排序
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categoryId String?   @map("category_id")             // 分类 ID（公告类型）
  category   NewspaperCategory? @relation(fields: [categoryId], references: [id])

  templates   NewspaperTemplate[]

  @@map("newspapers")
}

/// 登报模板表
model NewspaperTemplate {
  id          String   @id @default(uuid())
  newspaperId String   @map("newspaper_id")            // 报纸 ID
  categoryId  String   @map("category_id")             // 分类 ID
  name        String                                  // 模板名称
  content     String   @db.Text                        // 模板内容（MD 格式）
  sampleData  String?  @map("sample_data")              // 示例数据（JSON）
  sort        Int      @default(0)                    // 排序
  status      Int      @default(1)                    // 状态
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  newspaper   Newspaper       @relation(fields: [newspaperId], references: [id])
  category    NewspaperCategory @relation(fields: [categoryId], references: [id])

  @@map("newspaper_templates")
}

/// 登报分类表
model NewspaperCategory {
  id          String   @id @default(uuid())
  name        String                                  // 分类名称
  icon        String?                                 // 图标
  sort        Int      @default(0)                    // 排序
  status      Int      @default(1)                    // 状态
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  templates   NewspaperTemplate[]
  newspapers  Newspaper[]

  @@map("newspaper_categories")
}

// ============================================================
// 评价模块
// ============================================================

/// 评价表
model Review {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")               // 订单 ID
  userId      String   @map("user_id")                 // 用户 ID
  module      String   @default("seal") @map("module")  // 模块：seal/newspaper
  rating      Int                                      // 评分：1-5
  content     String   @db.Text                        // 评价内容
  images      String[] @map("images")                  // 评价图片列表
  reply       String?  @db.Text                        // 商家回复
  replyAt     DateTime? @map("reply_at")              // 回复时间
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order       SealOrder @relation(fields: [orderId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// ============================================================
// 系统管理模块
// ============================================================

/// 管理员表
model Admin {
  id          String   @id @default(uuid())
  username    String   @unique                         // 登录用户名
  password    String   @map("password")                 // 密码（bcrypt 加密）
  nickname    String?                                 // 昵称
  role        String   @default("operator") @map("role") // 角色：admin/superadmin/operator/finance
  permissions String[] @map("permissions")             // 权限列表
  status      Int      @default(1)                    // 状态：0=禁用 1=正常
  lastLoginAt DateTime? @map("last_login_at")          // 最后登录时间
  lastLoginIp String?  @map("last_login_ip")           // 最后登录 IP
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

/// 操作日志表
model OperationLog {
  id          String   @id @default(uuid())
  adminId     String?  @map("admin_id")                 // 管理员 ID
  module      String?                                 // 操作模块
  action      String?                                 // 操作动作
  target      String?                                 // 操作对象
  detail      String?  @db.Text                        // 详情
  ip          String?                                 // IP 地址
  userAgent   String?  @map("user_agent")              // User-Agent
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("operation_logs")
}

/// 系统配置表
model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique                          // 配置键
  value       String   @db.Text                         // 配置值
  type        String   @default("string") @map("value_type") // 值类型
  group       String   @default("default")              // 配置分组
  name        String?                                 // 配置名称
  description String?  @map("description")              // 配置描述
  sort        Int      @default(0)                    // 排序
  status      Int      @default(1)                    // 状态
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}
// ============================================================
// 合作门店模块
// ============================================================

/// 合作门店表
model Store {
  id          String   @id @default(uuid())
  name        String                                  // 门店名称
  contact     String                                  // 联系人姓名
  phone       String   @unique                       // 联系电话（同时作为登录账号）
  password    String   @map("password")              // 登录密码（bcrypt 加密）
  province    String?                                 // 所在省份
  city        String?                                 // 所在城市
  address     String?                                 // 详细地址
  // 服务区域：JSON 数组，支持多省/多市
  // 格式：[{"province":"四川省","city":"成都市"},{"province":"四川省","city":"绵阳市"}]
  // 空数组表示服务全国（默认成都店兜底）
  serviceArea String   @default("[]") @map("service_area")
  status      Int      @default(1)                   // 状态：0=停用 1=正常
  totalOrders Int      @default(0)  @map("total_orders") // 累计处理订单数
  lastLoginAt DateTime? @map("last_login_at")       // 最后登录时间
  lastLoginIp String?  @map("last_login_ip")        // 最后登录 IP
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments OrderAssignment[]                        // 分配的订单
  receipts   DeliveryReceipt[]                        // 交付回执

  @@map("stores")
}

/// 订单分配表（总部→门店，一对一）
model OrderAssignment {
  id          String    @id @default(uuid())
  orderId     String    @unique @map("order_id")    // 订单 ID（唯一）
  storeId     String    @map("store_id")            // 门店 ID
  status      Int       @default(1)                   // 状态：1=待接单 2=制作中 3=已完成
  statusText  String    @default("待接单") @map("status_text")
  assignedBy  String?   @map("assigned_by")         // 分配的管理员 ID
  assignedAt  DateTime  @default(now()) @map("assigned_at") // 分配时间
  acceptedAt DateTime? @map("accepted_at")         // 门店接单时间
  completedAt DateTime? @map("completed_at")       // 门店完成时间
  remark      String?                                 // 分配备注

  order       SealOrder @relation(fields: [orderId], references: [id])
  store       Store     @relation(fields: [storeId], references: [id])

  @@map("order_assignments")
}

/// 交付回执表
model DeliveryReceipt {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")             // 订单 ID
  storeId     String   @map("store_id")             // 上传的门店 ID
  type        String                                  // 回执类型：certificate=备案证明 / signature=盖章文件 / other=其他
  url         String                                  // 文件 URL
  remark      String?                                 // 备注
  createdAt   DateTime @default(now()) @map("created_at")

  order       SealOrder @relation(fields: [orderId], references: [id])
  store       Store     @relation(fields: [storeId], references: [id])

  @@map("delivery_receipts")
}

