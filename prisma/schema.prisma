generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id         String   @id @default(uuid())
  user_id    String
  contact    String
  phone      String
  province   String
  city       String
  district   String
  detail     String
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model admins {
  id            String    @id @default(uuid())
  username      String    @unique
  password      String
  nickname      String?
  role          String    @default("operator")
  permissions   String[]
  status        Int       @default(1)
  last_login_at DateTime?
  last_login_ip String?
  created_at    DateTime  @default(now())
  updated_at    DateTime @updatedAt
}

model bookkeeping_packages {
  id            String   @id @default(uuid())
  name          String
  taxpayer_type String
  cycle         String
  base_price    Decimal  @db.Decimal(10, 2)
  invoice_price       Decimal  @default(0) @db.Decimal(10, 2)
  invoice_price_normal Decimal @default(0) @db.Decimal(10, 2)
  social_price        Decimal  @default(0) @db.Decimal(10, 2)
  fund_price    Decimal  @default(0) @db.Decimal(10, 2)
  description   String?
  features      String?
  sort          Int      @default(0)
  status        Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([taxpayer_type, cycle])
}

model delivery_receipts {
  id          String      @id @default(uuid())
  order_id    String
  outlet_id   String
  type        String
  url         String
  remark      String?
  created_at  DateTime    @default(now())
  seal_orders seal_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  outlet     outlets     @relation(fields: [outlet_id], references: [id])
}

model invoices {
  id           String   @id @default(uuid())
  user_id      String
  type         Int      @default(1)
  title        String
  tax_no       String?
  bank         String?
  bank_account String?
  address      String?
  phone        String?
  email        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model materials {
  id          String      @id @default(uuid())
  order_id    String
  type        String
  url         String
  status      Int         @default(0)
  remark      String?
  created_at  DateTime    @default(now())
  updated_at  DateTime @updatedAt
  seal_orders seal_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model newspaper_categories {
  id                  String                @id @default(uuid())
  name                String
  icon                String?
  sort                Int                   @default(0)
  status              Int                   @default(1)
  created_at          DateTime              @default(now())
  updated_at          DateTime @updatedAt
  newspaper_templates newspaper_templates[]
  newspapers          newspapers[]
}

model newspaper_templates {
  id                   String               @id @default(uuid())
  newspaper_id         String?
  category_id          String
  name                 String
  content              String
  sample_data          String?
  sort                 Int                  @default(0)
  status               Int                  @default(1)
  created_at           DateTime             @default(now())
  updated_at           DateTime @updatedAt
  businessType         String?
  color                String?
  desc                 String?
  templateType         String?
  newspaper_categories newspaper_categories @relation(fields: [category_id], references: [id])
  newspaper           newspapers?          @relation(fields: [newspaper_id], references: [id])
}

model newspapers {
  id                   String                @id @default(uuid())
  name                 String
  alias                String?
  publisher            String?
  province             String?
  city                 String?
  price_per_word       Decimal               @db.Decimal(10, 2)
  min_words            Int                   @default(50)
  coverage             Int                   @default(1)
  level                Int                   @default(1)
  image                String?
  description          String?
  status               Int                   @default(1)
  sort                 Int                   @default(0)
  created_at           DateTime              @default(now())
  updated_at           DateTime @updatedAt
  category_id          String?
  city_code            String?
  province_code        String?
  region               String?
  newspaper_templates  newspaper_templates[]
  newspaper_categories newspaper_categories? @relation(fields: [category_id], references: [id])
}

model operation_logs {
  id         String   @id @default(uuid())
  admin_id   String?
  module     String?
  action     String?
  target     String?
  detail     String?
  ip         String?
  user_agent String?
  created_at DateTime @default(now())
}

model order_assignments {
  id           String      @id @default(uuid())
  order_id     String      @unique
  outlet_id    String
  status       Int         @default(1)
  status_text  String      @default("待接单")
  assigned_by  String?
  assigned_at  DateTime    @default(now())
  accepted_at  DateTime?
  completed_at DateTime?
  remark       String?
  seal_orders  seal_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  outlet      outlets     @relation(fields: [outlet_id], references: [id])
}

model order_items {
  id            String         @id @default(uuid())
  order_id      String
  item_type     String
  seal_id       String?
  package_id    String?
  name          String
  price         Decimal        @db.Decimal(10, 2)
  quantity      Int            @default(1)
  image         String?
  created_at    DateTime       @default(now())
  seal_orders   seal_orders    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  package seal_packages? @relation(fields: [package_id], references: [id])
  seal         seals?         @relation(fields: [seal_id], references: [id])
}

model outlet_notifications {
  id         String   @id @default(uuid())
  outlet_id  String
  title      String
  content    String
  type       String   @default("order")
  order_id   String?
  order_no   String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  outlet    outlets  @relation(fields: [outlet_id], references: [id])

  @@index([outlet_id, created_at])
  @@index([outlet_id, is_read])
}

model outlets {
  id                   String                 @id @default(uuid())
  name                 String
  contact              String
  phone                String                 @unique
  password             String
  province             String?
  city                 String?
  address              String?
  status               Int                    @default(1)
  total_orders         Int                    @default(0)
  last_login_at        DateTime?
  last_login_ip        String?
  created_at           DateTime               @default(now())
  updated_at           DateTime @updatedAt
  service_area         String                 @default("[]")
  business_license     String?
  special_permits      String                 @default("[]")
  outlet_openid        String?
  subscribe_msg        Int                    @default(1)
  delivery_receipts    delivery_receipts[]
  assignments    order_assignments[]
  outlet_notifications outlet_notifications[]
}

model personal_doc_categories {
  id                 String               @id @default(uuid())
  name               String
  desc               String?
  color              String?
  icon               String?
  sort               Int                  @default(0)
  status             Int                  @default(1)
  created_at         DateTime             @default(now())
  updated_at         DateTime @updatedAt
  personal_doc_items personal_doc_items[]
}

model personal_doc_items {
  id                      String                  @id @default(uuid())
  category_id             String
  name                    String
  content                 String?
  desc                    String?
  sort                    Int                     @default(0)
  status                  Int                     @default(1)
  created_at              DateTime                @default(now())
  updated_at              DateTime @updatedAt
  personal_doc_categories personal_doc_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
}

model question_replies {
  id          String    @id @default(uuid())
  question_id String
  author_type String
  author_id   String
  author_name String
  content     String
  created_at  DateTime  @default(now())
  replies   questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([question_id])
}

model questions {
  id               String             @id @default(uuid())
  user_id          String?
  user_name        String             @default("热心用户")
  content          String
  images           String[]
  module           String             @default("seal_biz")
  status           String             @default("pending")
  reply_count      Int                @default(0)
  created_at       DateTime           @default(now())
  updated_at       DateTime @updatedAt
  question_replies question_replies[]
  user            users?             @relation(fields: [user_id], references: [id])

  @@index([module, status])
  @@index([status, created_at])
}

model reviews {
  id          String      @id @default(uuid())
  order_id    String
  user_id     String
  module      String      @default("seal")
  rating      Int
  content     String
  images      String[]
  reply       String?
  reply_at    DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime @updatedAt
  status      String      @default("pending")
  seal_orders seal_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user       users       @relation(fields: [user_id], references: [id])
}

model seal_categories {
  id         String   @id @default(uuid())
  name       String
  icon       String?
  sort       Int      @default(0)
  status     Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  seals      seals[]
}

model seal_orders {
  id                    String              @id @default(uuid())
  order_no              String              @unique
  user_id               String
  module                String              @default("seal")
  type                  String              @default("在线刻章")
  company_name          String?
  legal_person          String?
  license_region        String?
  seal_reason           String?
  contact_phone         String?
  legal_phone           String?
  total_price           Decimal             @db.Decimal(10, 2)
  pay_price             Decimal?            @db.Decimal(10, 2)
  address_id            String?
  address_json          String?
  need_invoice          Boolean             @default(false)
  invoice_id            String?
  status                Int                 @default(1)
  status_text           String              @default("待支付")
  remark                String?
  pay_time              DateTime?
  pay_method            String?
  transaction_id        String?
  express_company       String?
  express_no            String?
  admin_remark          String?
  processed_by          String?
  processed_at          DateTime?
  created_at            DateTime            @default(now())
  updated_at            DateTime @updatedAt
  assignment_status     Int                 @default(0)
  delivered_at          DateTime?
  delivery_status       Int                 @default(0)
  signed_at             DateTime?
  newspaper_content     String?
  newspaper_issue_count Int?
  invoice_json          String?
  newspaper_copy_count  Int?
  newspaper_images      String?
  delivery_receipts     delivery_receipts[]
  materials             materials[]
  assignment     order_assignments?
  order_items           order_items[]
  reviews               reviews[]
  user                 users               @relation(fields: [user_id], references: [id])
}

model seal_packages {
  id                  String                @id @default(uuid())
  name                String
  description         String?
  badge               String?
  price               Decimal               @db.Decimal(10, 2)
  seal_ids            String[]
  status              Int                   @default(1)
  sort                Int                   @default(0)
  created_at          DateTime              @default(now())
  updated_at          DateTime @updatedAt
  images              String[]
  order_items         order_items[]
  seal_scene_packages seal_scene_packages[]
}

model seal_scene_packages {
  scene_id      String
  package_id    String
  sort          Int           @default(0)
  created_at    DateTime      @default(now())
  package seal_packages @relation(fields: [package_id], references: [id])
  seal_scenes   seal_scenes   @relation(fields: [scene_id], references: [id])

  @@id([scene_id, package_id])
}

model seal_scene_seals {
  scene_id    String
  seal_id     String
  sort        Int         @default(0)
  created_at  DateTime    @default(now())
  seal_scenes seal_scenes @relation(fields: [scene_id], references: [id])
  seal       seals       @relation(fields: [seal_id], references: [id])

  @@id([scene_id, seal_id])
}

model seal_scenes {
  id                  String                @id @default(uuid())
  name                String
  description         String?
  icon                String?
  bgColor             String?
  route               String?
  sort                Int                   @default(0)
  status              Int                   @default(1)
  sceneType           String                @default("scene")
  created_at          DateTime              @default(now())
  updated_at          DateTime @updatedAt
  seal_scene_packages seal_scene_packages[]
  seal_scene_seals    seal_scene_seals[]
}

model seals {
  id               String             @id @default(uuid())
  category_id      String?
  name             String
  description      String?
  image            String?
  price            Decimal            @db.Decimal(10, 2)
  region_prices   Json              @default("{}") @db.Json
  status           Int                @default(1)
  sort             Int                @default(0)
  created_at       DateTime           @default(now())
  updated_at       DateTime @updatedAt
  order_items      order_items[]
  seal_scene_seals seal_scene_seals[]
  seal_categories  seal_categories?   @relation(fields: [category_id], references: [id])
}

model system_configs {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  value_type  String   @default("string")
  group       String   @default("default")
  name        String?
  description String?
  sort        Int      @default(0)
  status      Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model users {
  id            String        @id @default(uuid())
  openid        String?       @unique
  unionid       String?       @unique
  nickname      String?
  avatar        String?
  phone         String?       @unique
  realname      String?
  id_card       String?
  status        Int           @default(1)
  last_login_at DateTime?
  last_login_ip String?
  created_at    DateTime      @default(now())
  updated_at    DateTime @updatedAt
  addresses     addresses[]
  invoices      invoices[]
  questions     questions[]
  reviews       reviews[]
  seal_orders   seal_orders[]
}
